    button ig-reference (
        buttonName: IG_REFERENCE
        label: Full IG reference
        layout {
            sequence: 50
            region: @theme-lab-overlays
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1410
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button calendar-reference (
        buttonName: CALENDAR_REFERENCE
        label: Full calendar reference
        layout {
            sequence: 60
            region: @theme-lab-overlays
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1800
                action: resetPagination
            }
