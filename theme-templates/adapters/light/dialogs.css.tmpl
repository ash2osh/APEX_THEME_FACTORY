/* Shared light-family adapter rules for css/apex/dialogs.css - rendered into estate-slate, citrus-pop, cobalt-press.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
/* Modal dialogs and popup menus.
   Scoped to .app-theme-__NAME__ .apex-theme-iris. */

.app-theme-__NAME__ .apex-theme-iris {
    --jui-dialog-border-radius: var(--app-radius-lg);
    --jui-dialog-shadow: var(--app-shadow-dialog), 0 0 0 1px var(--app-border-color);
    --jui-dialog-border-color: var(--app-border-color);
    --jui-dialog-titlebar-border-color: var(--app-border-color);
    --jui-dialog-titlebar-padding-x: 1.25rem;
    --jui-dialog-title-font-weight: var(--app-font-weight-semibold);
    --jui-dialog-title-close-border-radius: var(--app-radius-sm);
    --jui-dialog-title-close-border-color: transparent;
    --jui-dialog-buttonpane-background-color: var(--app-surface-subtle);
    --jui-dialog-buttonpane-border-color: var(--app-border-color);
    --jui-overlay-background-color: var(--app-overlay-background);

    --a-menu-shadow: var(--app-shadow-dialog);
    --a-menu-border-radius: var(--app-radius-md);
    --a-menu-border-color: var(--app-border-color);
    --a-menu-text-color: var(--app-text-emphasized);
    --a-menu-default-text-color: var(--app-text-emphasized);
    --a-menu-focused-text-color: var(--app-text-emphasized);
    --a-menu-font-weight: var(--app-font-weight-medium);
    --a-menu-accel-text-color: var(--app-text-primary);
    --a-menu-default-accel-text-color: var(--app-text-primary);
    --a-menu-focused-accel-text-color: var(--app-text-emphasized);
}
