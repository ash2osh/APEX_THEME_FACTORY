#!/usr/bin/env python3
"""Fake SQLcl executable for testing.

Emulates SQLcl commands used by Theme Factory (export, import, validate, queries)
without requiring a live Oracle Database or Java SQLcl installation.
"""
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def normalize_path(p: str) -> Path:
    if not p:
        return Path(p)
    if sys.platform == "win32" and re.match(r"^/[a-zA-Z](/|$)", p):
        p = f"{p[1]}:{p[2:]}"
    return Path(p)


def main() -> None:
    input_data = sys.stdin.read()
    fake_log = os.environ.get("FAKE_SQL_LOG")
    if fake_log:
        with open(fake_log, "a", encoding="utf-8") as f:
            args_str = " ".join(sys.argv[1:])
            f.write(f"argv={args_str}\nstdin={input_data}\n")

    export_dir = ""
    m_dir = re.search(r'-dir\s+"([^"]+)"', input_data) or re.search(r'-dir\s+(\S+)', input_data)
    if m_dir:
        export_dir = str(normalize_path(m_dir.group(1)))

    default_state = Path(tempfile.gettempdir()) / f"fake_sql_imported_{os.environ.get('USER', 'default')}.txt"
    state_file = Path(os.environ.get("FAKE_SQL_STATE_FILE", default_state))
    fixture_bin = Path(__file__).resolve().parent
    fixture_root_default = fixture_bin.parent / "apexlang" / os.environ.get("FAKE_SQL_FIXTURE", "minimal")
    fixture_root = Path(os.environ.get("FAKE_SQL_FIXTURE_DIR", fixture_root_default))

    def reexport(dest: Path) -> None:
        stored = normalize_path(state_file.read_text(encoding="utf-8").strip())
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(stored, dest)
        subprocess.run([sys.executable, str(fixture_bin / "apexlang_roundtrip.py"), str(dest)], check=True)

    m_imp = re.search(r'apex\s+import\s+-input\s+"([^"]+)"', input_data) or re.search(r'apex\s+import\s+-input\s+(\S+)', input_data)
    if m_imp:
        imported_dir = normalize_path(m_imp.group(1))
        store = Path(f"{state_file}.d")
        if store.exists():
            shutil.rmtree(store)
        shutil.copytree(imported_dir, store)
        state_file.parent.mkdir(parents=True, exist_ok=True)
        state_file.write_text(str(store), encoding="utf-8")

    mode = os.environ.get("FAKE_SQL_MODE", "success")

    if mode == "success":
        if "apex export" in input_data and export_dir:
            ed = Path(export_dir)
            ed.mkdir(parents=True, exist_ok=True)
            target = ed / "fixture-app"
            if state_file.is_file() and Path(state_file.read_text(encoding="utf-8").strip()).is_dir():
                reexport(target)
            else:
                if target.exists():
                    shutil.rmtree(target)
                shutil.copytree(fixture_root, target)

        if "THEME_FACTORY_TARGET=" in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}\n')

        m_val = re.search(r'apex\s+validate\s+-input\s+"([^"]+)"', input_data) or re.search(r'apex\s+validate\s+-input\s+(\S+)', input_data)
        if m_val:
            val_dir = m_val.group(1)
            ret = subprocess.run([sys.executable, str(fixture_bin / "apexlang_lint.py"), val_dir])
            if ret.returncode != 0:
                sys.exit(1)

        if "between 9000 and 9099" in input_data or "CONSUMER_OCCUPIED_QUERY" in input_data:
            occupied = os.environ.get("FAKE_SQL_OCCUPIED_IDS")
            if occupied:
                for aid in occupied.split(","):
                    aid = aid.strip()
                    if aid:
                        sys.stdout.write(f"{aid}|OCCUPIED_APP_{aid}\n")
        elif "CONSUMER_EXISTING_QUERY" in input_data or "from apex_applications where application_id in" in input_data:
            existing = os.environ.get("FAKE_SQL_EXISTING_APPS")
            if existing:
                for app in existing.split(","):
                    app = app.strip()
                    if app and ":" in app:
                        aid, aalias = app.split(":", 1)
                        sys.stdout.write(f"{aid}|{aalias}\n")
        elif "count(*)" in input_data and "apex_applications" in input_data:
            sys.stdout.write("0\n")
        elif "apex_applications" in input_data and "THEME_FACTORY_TARGET=" not in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}\n')

        sys.stdout.write("Validation completed successfully.\n")

    elif mode == "validation-warning":
        if "THEME_FACTORY_TARGET=" in input_data or "apex_applications" in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}\n')
        if "apex export" in input_data and export_dir:
            ed = Path(export_dir)
            ed.mkdir(parents=True, exist_ok=True)
            target = ed / "fixture-app"
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(fixture_root, target)
        if "apex validate" in input_data:
            sys.stdout.write("WARNING fixture validation warning\n")

    elif mode == "export-two-aliases":
        if export_dir:
            ed = Path(export_dir)
            ed.mkdir(parents=True, exist_ok=True)
            for sub in ("one", "two"):
                target = ed / sub
                if target.exists():
                    shutil.rmtree(target)
                shutil.copytree(fixture_root, target)

    elif mode == "connection-failure":
        sys.stderr.write("ORA-17820: network adapter error\n")
        sys.exit(1)

    elif mode == "import-failure":
        sys.stderr.write("ERROR import failed\n")
        sys.exit(1)

    elif mode == "postcheck-fail":
        if "apex export" in input_data and export_dir:
            ed = Path(export_dir)
            ed.mkdir(parents=True, exist_ok=True)
            target = ed / "fixture-app"
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(fixture_root, target)
        if "THEME_FACTORY_TARGET=" in input_data or "apex_applications" in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}\n')
        sys.stdout.write("Validation completed successfully.\n")

    elif mode == "postcheck-diverge":
        if "apex export" in input_data and export_dir:
            ed = Path(export_dir)
            ed.mkdir(parents=True, exist_ok=True)
            target = ed / "fixture-app"
            if state_file.is_file() and Path(state_file.read_text(encoding="utf-8").strip()).is_dir():
                reexport(target)
                files_apx = target / "shared-components" / "static-files.apx"
                with open(files_apx, "a", encoding="utf-8") as f:
                    f.write('\nfile "divergence.css" (\n    mimeType: text/css\n    charSet: utf-8\n)\n')
            else:
                if target.exists():
                    shutil.rmtree(target)
                shutil.copytree(fixture_root, target)
        if "THEME_FACTORY_TARGET=" in input_data or "apex_applications" in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}\n')
        sys.stdout.write("Validation completed successfully.\n")

    elif mode == "unsupported-apex":
        if "THEME_FACTORY_TARGET=" in input_data or "apex_applications" in input_data:
            sys.stdout.write('THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.2.0"}\n')
        sys.stdout.write("Validation completed successfully.\n")

    else:
        sys.stderr.write(f"unknown FAKE_SQL_MODE={mode}\n")
        sys.exit(2)


if __name__ == "__main__":
    main()
