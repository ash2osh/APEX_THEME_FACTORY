page 1 (
    name: Home
    alias: HOME
    title: Home - &APP_TITLE.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region business-form (
        name: Business Form
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: business_form
        }
    )

    pageItem P1_NAME (
        type: textField
        label {
            label: Customer Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @business-form
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1_AMOUNT (
        type: numberField
        label {
            label: Order Amount
            alignment: left
        }
        layout {
            sequence: 20
            region: @business-form
            slot: regionBody
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
    )

    button save (
        buttonName: SAVE
        label: Save Order
        layout {
            sequence: 30
            region: @business-form
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: submitPage
        }
    )

    validation amount-positive (
        name: Amount Must Be Positive
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: to_number(:P1_AMOUNT) > 0
        }
        error {
            errorMessage: Amount must be greater than zero.
            associatedItem: @P1_AMOUNT
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    region business-cards (
        name: Business Cards
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select level as id, 'Row ' || level as title, 'Description for row ' || level as body
                from dual
                connect by level <= 12
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: business_cards
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: TITLE
        }
        body {
            column: BODY
        }
    )

    region business-drawer (
        name: Business Drawer
        type: staticContent
        source {
            htmlCode: <p>Business Drawer Content</p>
        }
        layout {
            sequence: 30
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-drawer
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: business_drawer
        }
    )
)
