/* Shared dark-family adapter rules for css/apex/regions.css - rendered into solarized-dark, carbon-volt, velvet-signal.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
/* ---- Standard region: card surface, 6px radius, hairline border, no shadow ------------------ */
.app-theme-__NAME__ .apex-theme-iris .t-Region {
    --ut-region-border-radius: var(--app-radius-md);
    --ut-region-box-shadow: none;
    --ut-region-header-padding-y: .75rem;
    --ut-region-header-padding-x: 1rem;
    --ut-region-body-padding-x: 1rem;
    --ut-region-body-padding-y: 1rem;
}
.app-theme-__NAME__ .apex-theme-iris .t-Region-header {
    font-size: var(--app-text-md);
    font-weight: var(--app-font-weight-semibold);
    line-height: 1.25rem;
}
.app-theme-__NAME__ .apex-theme-iris .t-Region-headerIcon {
    color: var(--__PREFIX__-cyan);                             /* graphic: ≥ 3:1 */
}

/* ---- Cards region (.a-CardView): atoms are declared on :root by Core → override on body ---- */
.app-theme-__NAME__ .apex-theme-iris {
    --a-cv-background-color: var(--app-surface-card);
    --a-cv-hover-background-color: var(--app-surface-hover);
    --a-cv-hover-border-color: var(--__PREFIX__-cyan);
    --a-cv-hover-text-color: var(--app-text-emphasized);
    --a-cv-active-background-color: var(--app-surface-selected);
    --a-cv-focus-border-color: var(--__PREFIX__-cyan);
    --a-cv-border-color: var(--app-border-color);
    --a-cv-border-radius: var(--app-radius-md);
    --a-cv-shadow: none;
    --a-cv-hover-shadow: none;
    --a-cv-active-shadow: none;
    --a-cv-text-color: var(--app-text-primary);
    --a-cv-title-text-color: var(--app-text-emphasized);
    --a-cv-title-font-weight: var(--app-font-weight-semibold);
    --a-cv-subtitle-text-color: var(--app-text-secondary);
    --a-cv-maincontent-text-color: var(--app-text-primary);
    --a-cv-subcontent-text-color: var(--app-text-secondary);
    --a-cv-header-border-color: var(--app-border-color);
    --a-cv-actions-border-color: var(--app-border-color);
    --a-cv-badge-background-color: var(--__PREFIX__-cyan);
    --a-cv-badge-text-color: var(--app-text-on-accent);    /* the accent-on-tint badge failed AA */
    --a-cv-media-background-color: var(--app-surface-page);
    --a-cv-media-overlay-color: var(--app-card-media-overlay);
    --a-cv-active-border-color: var(--__PREFIX__-cyan);
    --a-cv-icon-background-color: var(--__PREFIX__-cyan);           /* Iris hard-codes its own teal #00688c here */
    --a-cv-icon-text-color: var(--app-text-on-accent);
    --a-cv-initials-background-color: var(--__PREFIX__-cyan);
    --a-cv-initials-text-color: var(--app-text-on-accent);
}
.app-theme-__NAME__ .apex-theme-iris .t-CardsRegion {
    background-color: transparent;
    border-color: var(--app-border-color);
}

/* ---- Wizard region: chrome header/footer, cyan active step, green completed step ----------- */
.app-theme-__NAME__ .apex-theme-iris .t-Wizard {
    --ut-wizard-box-shadow: none;
    --ut-wizard-border-color: var(--app-border-color);
}
.app-theme-__NAME__ .apex-theme-iris .t-Wizard-header,
.app-theme-__NAME__ .apex-theme-iris .t-Wizard-footer {
    background-color: var(--app-surface-chrome);
}
.app-theme-__NAME__ .apex-theme-iris .t-Wizard-header {
    border-bottom: 1px solid var(--app-border-color);
}
.app-theme-__NAME__ .apex-theme-iris .t-Wizard-footer {
    border-top: 1px solid var(--app-border-color);
}
.app-theme-__NAME__ .apex-theme-iris .t-Wizard-title {
    font-weight: var(--app-font-weight-semibold);
}
.app-theme-__NAME__ .apex-theme-iris .t-WizardSteps {
    --ut-wp-label-color: var(--app-text-secondary);
    --ut-wp-active-background-color: var(--__PREFIX__-cyan);
    --ut-wp-active-text-color: var(--app-text-on-accent);
    --ut-wp-complete-background-color: var(--__PREFIX__-green);
    --ut-wp-checkmark-color: var(--app-text-on-accent);   /* dark check on the green fill */
    --ut-wp-label-active-font-weight: var(--app-font-weight-semibold);
}
.app-theme-__NAME__ .apex-theme-iris .t-WizardSteps-step.is-active .t-WizardSteps-label {
    color: var(--app-text-emphasized);                 /* the accent label fell under 4.5:1 */
}
.app-theme-__NAME__ .apex-theme-iris .t-WizardSteps-step.is-complete .t-WizardSteps-label {
    color: var(--app-text-primary);
}

/* ---- Cards (list template "Cards") -------------------------------------------------------- */
.app-theme-__NAME__ .apex-theme-iris .t-Cards {
    --ut-cardlist-border-radius: var(--app-radius-md);
    --ut-cardlist-box-shadow: none;
    --ut-cardlist-title-text-color: var(--app-text-emphasized);
    --ut-cardlist-title-font-weight: var(--app-font-weight-semibold);
    --ut-cardlist-subtitle-text-color: var(--app-text-secondary);
    --ut-cardlist-desc-color: var(--app-text-primary);
}
.app-theme-__NAME__ .apex-theme-iris .t-Cards .t-Card-wrap:hover,
.app-theme-__NAME__ .apex-theme-iris .t-Cards .t-Card-wrap:focus-visible {
    border-color: var(--__PREFIX__-cyan);
    background-color: var(--app-surface-hover);
}
.app-theme-__NAME__ .apex-theme-iris .t-Card-title {
    font-size: var(--app-text-md);
}

/* ---- Metric cards: cyan value (large text, needs ≥ 3:1) ----------------------------------- */
.app-theme-__NAME__ .apex-theme-iris .t-MetricCard {
    --ut-metric-card-shadow: none;
    --ut-metric-card-metric-text-color: var(--__PREFIX__-cyan);
    --ut-metric-card-meta-text-color: var(--app-text-secondary);
}

/* ---- Content blocks: heading scale 24 / 20 / 17, weight 600 ------------------------------- */
.app-theme-__NAME__ .apex-theme-iris .t-ContentBlock {
    --ut-content-block-header-font-weight: var(--app-font-weight-semibold);
    --ut-content-block-header-line-height: 1.3;
    --ut-content-block-border-radius: var(--app-radius-md);
    --ut-content-block-box-shadow: none;
}
.app-theme-__NAME__ .apex-theme-iris .t-ContentBlock--h1 { --ut-content-block-header-font-size: var(--app-text-2xl); }
.app-theme-__NAME__ .apex-theme-iris .t-ContentBlock--h2 { --ut-content-block-header-font-size: var(--app-text-xl); }
.app-theme-__NAME__ .apex-theme-iris .t-ContentBlock--h3 { --ut-content-block-header-font-size: var(--app-text-lg); }

/* Headings: light colour, avoid single-word last lines */
.app-theme-__NAME__ .apex-theme-iris .t-ContentBlock-title,
.app-theme-__NAME__ .apex-theme-iris .t-HeroRegion-title,
.app-theme-__NAME__ .apex-theme-iris .t-Region-title {
    text-wrap: balance;
    color: var(--app-text-emphasized);
}

/* ---- Breadcrumb-as-title in the title bar --------------------------------------------------- */
.app-theme-__NAME__ .apex-theme-iris .t-Body-title {
    --ut-breadcrumb-title-font-size: var(--app-text-2xl);
    --ut-breadcrumb-title-line-height: 2rem;
    --ut-breadcrumb-title-font-weight: var(--app-font-weight-semibold);
    --ut-breadcrumb-item-text-color: var(--app-text-secondary);
    --ut-breadcrumb-item-active-text-color: var(--app-text-emphasized);
}
