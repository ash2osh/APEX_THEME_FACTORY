/* Shared light-family adapter rules for css/apex/misc.css - rendered into estate-slate, citrus-pop, cobalt-press.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
/* Alerts, badges, tabs — status pills and indicator badges.
   Scoped to .app-theme-__NAME__ .apex-theme-iris. */

.app-theme-__NAME__ .apex-theme-iris {
    --ut-alert-box-shadow: none;
    --ut-badge-border-radius: var(--app-radius-sm);
    --ut-component-badge-border-radius: var(--app-radius-sm);
    --ut-component-box-shadow: var(--app-shadow-sm);
    --ut-button-region-box-shadow: none;
    --ut-cardlist-box-shadow: none;
    --ut-irr-region-box-shadow: none;
}

/* @segment 2 */
/* Chart labels — JET paints axis ticks and series labels as SVG fill, and the shared grey
   (147,161,161) misses AA on these light surfaces. Reuse the package's secondary text token. */
.app-theme-__NAME__ .apex-theme-iris svg text {
    fill: var(--app-text-secondary);
}

/* Circular badge list on a palette colour: the label takes the swatch's own contrast ink (inherited from the
   .u-color anchor), not the theme's title colour, which is 1.7-2.8:1 on the orange and teal swatches (p1304, 26.2). */
.app-theme-__NAME__ .apex-theme-iris .t-BadgeList--circular .u-color .t-BadgeList-label {
    color: inherit;
}

/* Demo markup: the template-directive sample colours its directive with a literal (#008676), which fails AA on these
   surfaces (p6400). Use the package's primary text tint instead. */
.app-theme-__NAME__ .apex-theme-iris .directive {
    color: var(--ut-palette-primary-text);
}

/* Demo markup: the .item sample is coloured with a literal purple (#9c27b0), which is too faint on these surfaces (p6400). */
.app-theme-__NAME__ .apex-theme-iris .item {
    color: var(--app-text-emphasized);
}

/* Demo markup: the .red sample is pure CSS red (#ff0000), which fails AA on these surfaces (p6307). */
.app-theme-__NAME__ .apex-theme-iris .red {
    color: var(--ut-palette-danger-text);
}
