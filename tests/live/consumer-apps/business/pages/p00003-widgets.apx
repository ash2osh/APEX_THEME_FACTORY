page 3 (
    name: Widgets
    alias: WIDGETS
    title: Widgets - &APP_TITLE.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region business-calendar (
        name: Business Calendar
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select level as id, 'Row ' || level as label, sysdate + level as start_date
                from dual
                connect by level <= 12
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: business_calendar
        }
        settings {
            displayColumn: LABEL
            startDateColumn: START_DATE
        }
    )

    region business-chart (
        name: Business Chart
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: business_chart
        }
        chartLayout {
            height: 300
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select level as value, 'Row ' || level as label
                    from dual
                    connect by level <= 5
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
        )
    )
)
