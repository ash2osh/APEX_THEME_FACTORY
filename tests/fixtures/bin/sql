#!/usr/bin/env bash
set -euo pipefail
input="$(cat /dev/stdin)"
if [ -n "${FAKE_SQL_LOG:-}" ]; then
  printf 'argv=%q\nstdin=%s\n' "$*" "$input" >>"$FAKE_SQL_LOG"
fi
export_dir=""
if [[ "$input" =~ -dir[[:space:]]+\"([^\"]+)\" ]]; then
  export_dir="${BASH_REMATCH[1]}"
elif [[ "$input" =~ -dir[[:space:]]+([^[:space:]]+) ]]; then
  export_dir="${BASH_REMATCH[1]}"
fi

state_file="/tmp/fake_sql_imported_${USER:-default}.txt"
fixture_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/apexlang/minimal"

if [[ "$input" =~ apex[[:space:]]+import[[:space:]]+-input[[:space:]]+\"([^\"]+)\" ]] || [[ "$input" =~ apex[[:space:]]+import[[:space:]]+-input[[:space:]]+([^[:space:]]+) ]]; then
  imported_dir="${BASH_REMATCH[1]}"
  echo "$imported_dir" > "$state_file"
fi

case "${FAKE_SQL_MODE:-success}" in
  success)
    if [[ "$input" == *"apex export"* ]] && [ -n "$export_dir" ]; then
      mkdir -p "$export_dir"
      if [ -f "$state_file" ] && [ -d "$(cat "$state_file")" ]; then
        cp -R "$(cat "$state_file")" "$export_dir/fixture-app"
      else
        cp -R "$fixture_root" "$export_dir/fixture-app"
      fi
    fi
    if [[ "$input" == *"THEME_FACTORY_TARGET="* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}'
    fi
    if [[ "$input" == *"between 9000 and 9099"* ]] || [[ "$input" == *"CONSUMER_OCCUPIED_QUERY"* ]]; then
      if [ -n "${FAKE_SQL_OCCUPIED_IDS:-}" ]; then
        IFS=',' read -ra ADDR <<< "$FAKE_SQL_OCCUPIED_IDS"
        for id in "${ADDR[@]}"; do
          printf '%s|%s\n' "$id" "OCCUPIED_APP_$id"
        done
      fi
    elif [[ "$input" == *"CONSUMER_EXISTING_QUERY"* ]] || [[ "$input" == *"from apex_applications where application_id in"* ]]; then
      if [ -n "${FAKE_SQL_EXISTING_APPS:-}" ]; then
        IFS=',' read -ra APPS <<< "$FAKE_SQL_EXISTING_APPS"
        for app in "${APPS[@]}"; do
          IFS=':' read -r aid aalias <<< "$app"
          printf '%s|%s\n' "$aid" "$aalias"
        done
      fi
    elif [[ "$input" == *"count(*)"* ]] && [[ "$input" == *"apex_applications"* ]]; then
      printf '0\n'
    elif [[ "$input" == *"apex_applications"* ]] && [[ "$input" != *"THEME_FACTORY_TARGET="* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}'
    fi
    printf '%s\n' 'Validation completed successfully.'
    ;;
  validation-warning)
    if [[ "$input" == *"THEME_FACTORY_TARGET="* ]] || [[ "$input" == *"apex_applications"* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}'
    fi
    if [[ "$input" == *"apex export"* ]] && [ -n "$export_dir" ]; then
      mkdir -p "$export_dir"
      cp -R "$fixture_root" "$export_dir/fixture-app"
    fi
    if [[ "$input" == *"apex validate"* ]]; then
      printf '%s\n' 'WARNING fixture validation warning'
    fi
    ;;
  export-two-aliases)
    if [ -n "$export_dir" ]; then
      mkdir -p "$export_dir"
      cp -R "$fixture_root" "$export_dir/one"
      cp -R "$fixture_root" "$export_dir/two"
    fi
    ;;
  connection-failure)
    printf '%s\n' 'ORA-17820: network adapter error' >&2
    exit 1
    ;;
  import-failure)
    printf '%s\n' 'ERROR import failed' >&2
    exit 1
    ;;
  postcheck-fail)
    if [[ "$input" == *"apex export"* ]] && [ -n "$export_dir" ]; then
      mkdir -p "$export_dir"
      cp -R "$fixture_root" "$export_dir/fixture-app"
    fi
    if [[ "$input" == *"THEME_FACTORY_TARGET="* ]] || [[ "$input" == *"apex_applications"* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}'
    fi
    printf '%s\n' 'Validation completed successfully.'
    ;;
  postcheck-diverge)
    if [[ "$input" == *"apex export"* ]] && [ -n "$export_dir" ]; then
      mkdir -p "$export_dir"
      if [ -f "$state_file" ] && [ -d "$(cat "$state_file")" ]; then
        cp -R "$(cat "$state_file")" "$export_dir/fixture-app"
        printf '\n// post-import divergence\n' >> "$export_dir/fixture-app/application.apx"
      else
        cp -R "$fixture_root" "$export_dir/fixture-app"
      fi
    fi
    if [[ "$input" == *"THEME_FACTORY_TARGET="* ]] || [[ "$input" == *"apex_applications"* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.1.0"}'
    fi
    printf '%s\n' 'Validation completed successfully.'
    ;;
  unsupported-apex)
    if [[ "$input" == *"THEME_FACTORY_TARGET="* ]] || [[ "$input" == *"apex_applications"* ]]; then
      printf '%s\n' 'THEME_FACTORY_TARGET={"appId":314,"alias":"FIXTURE_APP","name":"Fixture App","workspace":"DEMO","apexVersion":"26.2.0"}'
    fi
    printf '%s\n' 'Validation completed successfully.'
    ;;
  *)
    printf 'unknown FAKE_SQL_MODE=%s\n' "${FAKE_SQL_MODE:-}" >&2
    exit 2
    ;;
esac
