/* Shared dark-family adapter rules for css/apex/misc.css - rendered into solarized-dark, carbon-volt, velvet-signal.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
.app-theme-__NAME__ .apex-theme-iris {
    --ut-alert-box-shadow: none;
    --ut-badge-border-radius: var(--app-radius-sm);
    --ut-component-badge-border-radius: var(--app-radius-sm);
    --ut-component-box-shadow: none;            /* generic component shadow (menus, popups, cards) */
    --ut-button-region-box-shadow: none;
    --ut-cardlist-box-shadow: none;
    --ut-irr-region-box-shadow: none;

    /* badges: solid accent fills with dark text (≥ 4.5:1); red keeps white text. Subtle variants sit on
       the translucent palette shades, so their text is the light body colour rather than the accent. */
    --ut-badge-background-color: var(--__PREFIX__-cyan);
    --ut-badge-text-color: var(--app-text-on-accent);
    --ut-badge-success-background-color: var(--__PREFIX__-green);
    --ut-badge-success-text-color: var(--app-text-on-accent);
    --ut-badge-warning-background-color: var(--__PREFIX__-yellow);
    --ut-badge-warning-text-color: var(--app-text-on-accent);
    --ut-badge-danger-background-color: var(--__PREFIX__-red);
    --ut-badge-danger-text-color: var(--app-badge-danger-text);
    --ut-badge-info-background-color: var(--__PREFIX__-cyan);
    --ut-badge-info-text-color: var(--app-text-on-accent);
    --ut-badge-subtle-background-color: var(--app-surface-hover);
    --ut-badge-subtle-text-color: var(--app-text-primary);
    --ut-badge-subtle-success-text-color: var(--app-text-primary);
    --ut-badge-subtle-warning-text-color: var(--app-text-primary);
    --ut-badge-subtle-danger-text-color: var(--app-text-primary);
    --ut-badge-subtle-info-text-color: var(--app-text-primary);

    /* tabs: muted items, light active label with a cyan highlight bar (graphic, ≥ 3:1) */
    --ut-tabs-border-color: var(--app-border-color);
    --ut-tabs-item-text-color: var(--app-text-secondary);
    --ut-tabs-item-active-text-color: var(--app-text-emphasized);
    --ut-tabs-item-active-highlight-color: var(--__PREFIX__-cyan);
    --ut-tabs-item-hover-background-color: var(--app-surface-hover);

    /* Faceted Search (p1411) */
    --a-fs-chart-background-color: var(--app-surface-card);
    --a-fs-chart-border-color: var(--app-border-color);   /* Iris: var(--ut-region-border-color) at :root —
                                                               near 1:1 on the same card surface otherwise */
    --a-fs-control-seperator-border-color: var(--app-border-color);
    --a-fs-filter-group-border-color: var(--app-border-color);
    --a-fs-filter-group-label-text-color: var(--app-text-secondary);
    --a-fs-toggle-background-color: var(--app-surface-input);
    --a-fs-toggle-text-color: var(--app-text-primary);
    --a-fs-toggle-border-color: var(--app-border-strong);   /* Iris resolves to --a-button-border-color
                                                                 rgba(0,0,0,.075) at :root — near 1:1 on the
                                                                 dark toggle surface, boundary invisible */

    /* Percent Graph item type (p423, p1601) */
    --a-percent-chart-background-color: var(--app-surface-subtle);
    --a-percent-chart-border-color: var(--app-border-color);
    --a-percent-chart-bar-background-color: var(--__PREFIX__-cyan);   /* paired with the dark bar text below; was
                                                                    still Iris' :root-resolved #00688c teal */
    --a-percent-chart-bar-border-color: var(--app-border-color);
    --a-percent-chart-bar-text-color: var(--app-text-on-accent);

    /* Help Text dialog (p1903) */
    --a-help-dialog-code-text-color: var(--app-text-secondary);

    /* Map legend (p1906) */
    --a-map-legend-title-text-color: var(--app-text-secondary);

    /* Chart tooltips (p1902, JET) */
    --ojet-tooltip-primary-text-color: var(--app-text-emphasized);
    --ojet-tooltip-secondary-text-color: var(--app-text-secondary);
    --ojet-tooltip-disabled-text-color: var(--app-text-secondary);
    --jui-tooltip-background-color: var(--app-surface-chrome);   /* Theme-Standard literal #fff otherwise —
                                                                      light text on white is unreadable */
    --jui-tooltip-border-color: var(--app-border-color);
    --jui-tooltip-shadow: var(--app-shadow-dialog);
    --jui-tooltip-text-color: var(--app-text-emphasized);         /* .oj-dvt-datatip's base `color:` (outside
                                                                       the --oj-core-text-color-* classified
                                                                       spans the --ojet-tooltip-* atoms cover)
                                                                       was still Theme-Standard's literal
                                                                       #000 — black on the dark chrome now that the
                                                                       background above is dark */
}

/* Alerts: card surface from the component tokens; a 4px accent on the leading edge names the type */
.app-theme-__NAME__ .apex-theme-iris .t-Alert--horizontal:not(.t-Alert--colorBG) {
    border-inline-start: 4px solid var(--ut-alert-icon-text-color, var(--__PREFIX__-cyan));
}

/* @segment 2 */
.app-theme-__NAME__ pre[class*="language-"],
.app-theme-__NAME__ code[class*="language-"] {
    color: var(--__PREFIX__-base1);
    text-shadow: none;
}
.app-theme-__NAME__ pre[class*="language-"] {
    background-color: var(--app-surface-page);
    border: 1px solid var(--app-border-color);
    border-radius: var(--app-radius-sm);
}
.app-theme-__NAME__ :not(pre) > code[class*="language-"] {
    background-color: var(--app-surface-page);
}
.app-theme-__NAME__ .token.comment,
.app-theme-__NAME__ .token.prolog,
.app-theme-__NAME__ .token.doctype,
.app-theme-__NAME__ .token.cdata { color: var(--__PREFIX__-base0); font-style: italic; }
.app-theme-__NAME__ .token.punctuation,
.app-theme-__NAME__ .token.operator { color: var(--__PREFIX__-base1); }
.app-theme-__NAME__ .token.keyword,
.app-theme-__NAME__ .token.atrule,
.app-theme-__NAME__ .token.important { color: var(--__PREFIX__-green); }
.app-theme-__NAME__ .token.string,
.app-theme-__NAME__ .token.char,
.app-theme-__NAME__ .token.attr-value,
.app-theme-__NAME__ .token.inserted { color: var(--__PREFIX__-cyan); }
.app-theme-__NAME__ .token.function,
.app-theme-__NAME__ .token.class-name,
.app-theme-__NAME__ .token.builtin { color: var(--__PREFIX__-blue-text); }
.app-theme-__NAME__ .token.property,
.app-theme-__NAME__ .token.tag,
.app-theme-__NAME__ .token.selector,
.app-theme-__NAME__ .token.attr-name,
.app-theme-__NAME__ .token.variable { color: var(--__PREFIX__-yellow); }
.app-theme-__NAME__ .token.number,
.app-theme-__NAME__ .token.boolean,
.app-theme-__NAME__ .token.constant,
.app-theme-__NAME__ .token.symbol,
.app-theme-__NAME__ .token.regex { color: var(--__PREFIX__-magenta-text); }
.app-theme-__NAME__ .token.entity,
.app-theme-__NAME__ .token.url,
.app-theme-__NAME__ .token.deleted { color: var(--__PREFIX__-orange-text); }

/* Reference-app demo surfaces. Some pages of app 102 style their own demo markup with literal light values in
   page inline CSS (p4000 Icons: input#P4000_SEARCH, .dm-Search-*, .dm-IconDialog-*; p6303/p6304 modifiers:
   .dm-Report--doc, .class*; p6100/p6200/p6201: .event-name, .icon-preview, .instructions). Under a dark
   package they turn white-on-white, so the package restates them here — Oracle's Vita Dark did the same
   inside the pages. Scoped to .app-theme-__NAME__; higher specificity than the page rules. */
.app-theme-__NAME__ input#P4000_SEARCH {
    background: var(--app-surface-input);
    border: 1px solid var(--app-border-strong);
    box-shadow: none;
}
.app-theme-__NAME__ .dm-Search-category {
    background: var(--app-surface-card);
    border: 1px solid var(--app-border-color);
    box-shadow: none;
}
.app-theme-__NAME__ .dm-Search-result:hover,
.app-theme-__NAME__ .dm-Search-result:focus {
    background-color: var(--app-surface-hover);
}
.app-theme-__NAME__ .dm-Search:empty:before {
    color: var(--app-text-secondary);              /* page inline CSS hard-codes rgba(0,0,0,.5) */
}
.app-theme-__NAME__ .dm-IconDialog-preview {
    background-image: none;                       /* light checkerboard */
    background-color: var(--app-surface-page);
    border-color: var(--app-border-color);
}
.app-theme-__NAME__ .dm-IconDialog-code,
.app-theme-__NAME__ .instructions {
    color: var(--app-text-secondary);
}
.app-theme-__NAME__ .dm-IconDialog-infoBody code {
    background-color: var(--app-surface-page);
    color: var(--app-text-primary);
}
.app-theme-__NAME__ .icon-preview {
    background: var(--app-surface-page);
    box-shadow: 0 0 0 1px var(--app-border-color) inset;
}
.app-theme-__NAME__ .dm-Report--doc {
    background: var(--app-surface-page);
    border-color: var(--app-border-color);
}
.app-theme-__NAME__ .dm-Report--doc th,
.app-theme-__NAME__ .dm-Report--doc td {
    border-color: var(--app-border-color);
}
/* p6303/p6304 class-name tokens (.class, .class-value, .class-var, .class.tag) also appear outside the doc table */
.app-theme-__NAME__ .apex-theme-iris .class {
    color: var(--__PREFIX__-magenta-text);               /* the page's #9C27B0 fails 4.5:1 on a dark card */
}
.app-theme-__NAME__ .apex-theme-iris .class.tag {
    background-color: var(--app-surface-card);
    box-shadow: inset 0 0 0 1px var(--app-border-color);
}
.app-theme-__NAME__ .apex-theme-iris .class-value,
.app-theme-__NAME__ .apex-theme-iris .class-var {
    color: var(--__PREFIX__-cyan-text);                  /* the page's #008676 fails 4.5:1 on a dark card */
}
.app-theme-__NAME__ .apex-theme-iris .dm-Report--doc .class-desc {
    color: var(--app-text-secondary);             /* rgba(0,0,0,.55) is near-invisible on a dark card */
}
.app-theme-__NAME__ .event-name,
.app-theme-__NAME__ code.event-name {
    text-shadow: none;
}
.app-theme-__NAME__ .event-name:hover,
.app-theme-__NAME__ code.event-name:hover {
    color: var(--app-text-emphasized);
    background: var(--app-surface-hover);
}

/* Calendar (FullCalendar 5). UT gives default events a literal #2578cf background but colours their text
   with --fc-event-text-color = --ut-palette-primary-contrast, which a dark package remaps to a dark colour
   for its light primary: dark text on #2578cf failed AA (3.3:1 where first measured, 2026-09-16).
   Put default events on the package primary so the primary / primary-contrast pair holds. */
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.fc-apex-events-default,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.fc-apex-events-default .fc-event-main {
    background-color: var(--app-color-primary);
    border-color: var(--app-color-primary);
}
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.fc-apex-events-default:hover {
    background-color: var(--app-color-primary);
    filter: brightness(1.08);
}

/* Map (p1906, p1601 map item). MapLibre's attribution bar paints its own translucent white plate and takes
   its text colour by inheritance, so the package's light body text landed on it (2.57:1 where first measured,
   p1906, 2026-09-17). Give the plate the package overlay so the inherited text has a dark ground (12.25:1
   for the text and its links there, measured with this rule injected). The zoom control group keeps MapLibre's white
   chrome on purpose (it is an opaque light patch, not a contrast failure) — its glyphs are
   dark SVG images that are not themable from CSS. */
.app-theme-__NAME__ .maplibregl-ctrl-attrib {
    background-color: var(--app-overlay-background);
}
.app-theme-__NAME__ .maplibregl-ctrl-attrib,
.app-theme-__NAME__ .maplibregl-ctrl-attrib a {
    color: var(--app-text-primary);
}

/* Custom calendar events: bright status fills pair with the package's dark accent text. */
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-green,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-green,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-green > td {
    --fc-event-text-color: var(--app-text-on-accent);
    background-color: var(--app-color-success);
    border-color: var(--app-color-success);
}
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-blue,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-blue,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-blue > td {
    --fc-event-text-color: var(--app-text-on-accent);
    background-color: var(--app-color-info);
    border-color: var(--app-color-info);
}
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-yellow,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-yellow,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-yellow > td {
    --fc-event-text-color: var(--app-text-on-accent);
    background-color: var(--app-color-warning);
    border-color: var(--app-color-warning);
}
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-green,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-green .fc-event-title,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-green .fc-list-event-time,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-green .fc-list-event-title,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-blue,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-blue .fc-event-title,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-blue .fc-list-event-time,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-blue .fc-list-event-title,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-yellow,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-event.apex-cal-yellow .fc-event-title,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-yellow .fc-list-event-time,
.app-theme-__NAME__ .apex-theme-iris .fc .fc-list-event.apex-cal-yellow .fc-list-event-title {
    color: var(--app-text-on-accent);
}
