/* @theme-factory-generated */
html.app-theme-__NAME__ .t-Button {
  min-height: var(--app-control-height);
  border-radius: var(--app-radius-sm);
  border-color: var(--app-border-color);
}

html.app-theme-__NAME__ .t-Button--hot {
  background: var(--app-accent);
  color: var(--app-on-accent);
}

html.app-theme-__NAME__ .t-Button:focus-visible {
  outline: var(--app-focus-width) solid var(--app-focus-color);
  outline-offset: var(--app-focus-offset);
}
