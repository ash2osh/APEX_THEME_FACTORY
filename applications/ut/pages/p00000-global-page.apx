page 0 (
    name: Page Zero

    region theme (
        name: Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <!-- APEX_THEME_FACTORY_MANAGED:BOOTSTRAP -->
                <script>
                window.APEX_THEME_FACTORY_CONFIG = {
                  appId: &APP_ID.,
                  defaultTheme: "linen",
                  switcherEnabled: true,
                  themes: [{"name": "carbon-volt", "title": "Carbon Volt", "className": "app-theme-carbon-volt"}, {"name": "citrus-pop", "title": "Citrus Pop", "className": "app-theme-citrus-pop"}, {"name": "cobalt-press", "title": "Cobalt Press", "className": "app-theme-cobalt-press"}, {"name": "estate-slate-dark", "title": "Estate Slate Dark", "className": "app-theme-estate-slate-dark"}, {"name": "estate-slate", "title": "Estate Slate", "className": "app-theme-estate-slate"}, {"name": "linen", "title": "Linen", "className": "app-theme-linen"}, {"name": "solarized-dark", "title": "Solarized Dark", "className": "app-theme-solarized-dark"}, {"name": "velvet-signal", "title": "Velvet Signal", "className": "app-theme-velvet-signal"}]
                };
                (function (doc, config) {
                  "use strict";
                  var root = doc.documentElement;
                  var key = "apex.themeFactory." + config.appId;
                  var allowed = ["iris"].concat(config.themes.map(function (theme) { return theme.name; }));
                  var selected = config.defaultTheme;
                  if (config.switcherEnabled) {
                    try {
                      var legacy = window.localStorage.getItem("app.theme");
                      if (legacy) {
                        if (!window.localStorage.getItem(key)) {
                          var migrated = legacy === "none" ? "iris" : legacy;
                          if (allowed.indexOf(migrated) !== -1) {
                            window.localStorage.setItem(key, migrated);
                          }
                        }
                        window.localStorage.removeItem("app.theme");
                      }
                      var match = /(?:^#|&)theme=([a-z0-9-]{1,40})(?:&|$)/.exec(window.location.hash);
                      if (match) {
                        var hashTheme = match[1];
                        if (hashTheme === "default") {
                          window.localStorage.removeItem(key);
                        } else {
                          if (hashTheme === "none") { hashTheme = "iris"; }
                          if (allowed.indexOf(hashTheme) !== -1) {
                            window.localStorage.setItem(key, hashTheme);
                          }
                        }
                      }
                      selected = window.localStorage.getItem(key) || selected;
                      if (allowed.indexOf(selected) === -1) {
                        window.localStorage.removeItem(key);
                        selected = config.defaultTheme;
                      }
                    } catch (e) {
                      selected = config.defaultTheme;
                    }
                  }
                  Array.prototype.slice.call(root.classList).forEach(function (name) {
                    if (name.indexOf("app-theme-") === 0) { root.classList.remove(name); }
                  });
                  if (selected !== "iris") { root.classList.add("app-theme-" + selected); }
                  root.dataset.appThemeDefault = config.defaultTheme;
                  root.dataset.appThemeCurrent = selected;
                }(document, window.APEX_THEME_FACTORY_CONFIG));
                </script>
                ```
        }
        layout {
            sequence: 15
            slot: banner
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region theme_dialog (
        name: Theme (dialog, drawer, wizard pages)
        type: staticContent
        source {
            htmlCode:
                ```html
                <!-- Page 0 may only use Standard-template slots; APEX maps them by position number, and
                     breadcrumbBar = #REGION_POSITION_01# = the first position of the Modal Dialog, Drawer and
                     Wizard Modal Dialog templates (those have no banner slot). Idempotent with region "theme". -->
                <!-- APEX_THEME_FACTORY_MANAGED:BOOTSTRAP -->
                <script>
                window.APEX_THEME_FACTORY_CONFIG = {
                  appId: &APP_ID.,
                  defaultTheme: "linen",
                  switcherEnabled: true,
                  themes: [{"name": "carbon-volt", "title": "Carbon Volt", "className": "app-theme-carbon-volt"}, {"name": "citrus-pop", "title": "Citrus Pop", "className": "app-theme-citrus-pop"}, {"name": "cobalt-press", "title": "Cobalt Press", "className": "app-theme-cobalt-press"}, {"name": "estate-slate-dark", "title": "Estate Slate Dark", "className": "app-theme-estate-slate-dark"}, {"name": "estate-slate", "title": "Estate Slate", "className": "app-theme-estate-slate"}, {"name": "linen", "title": "Linen", "className": "app-theme-linen"}, {"name": "solarized-dark", "title": "Solarized Dark", "className": "app-theme-solarized-dark"}, {"name": "velvet-signal", "title": "Velvet Signal", "className": "app-theme-velvet-signal"}]
                };
                (function (doc, config) {
                  "use strict";
                  var root = doc.documentElement;
                  var key = "apex.themeFactory." + config.appId;
                  var allowed = ["iris"].concat(config.themes.map(function (theme) { return theme.name; }));
                  var selected = config.defaultTheme;
                  if (config.switcherEnabled) {
                    try {
                      var legacy = window.localStorage.getItem("app.theme");
                      if (legacy) {
                        if (!window.localStorage.getItem(key)) {
                          var migrated = legacy === "none" ? "iris" : legacy;
                          if (allowed.indexOf(migrated) !== -1) {
                            window.localStorage.setItem(key, migrated);
                          }
                        }
                        window.localStorage.removeItem("app.theme");
                      }
                      var match = /(?:^#|&)theme=([a-z0-9-]{1,40})(?:&|$)/.exec(window.location.hash);
                      if (match) {
                        var hashTheme = match[1];
                        if (hashTheme === "default") {
                          window.localStorage.removeItem(key);
                        } else {
                          if (hashTheme === "none") { hashTheme = "iris"; }
                          if (allowed.indexOf(hashTheme) !== -1) {
                            window.localStorage.setItem(key, hashTheme);
                          }
                        }
                      }
                      selected = window.localStorage.getItem(key) || selected;
                      if (allowed.indexOf(selected) === -1) {
                        window.localStorage.removeItem(key);
                        selected = config.defaultTheme;
                      }
                    } catch (e) {
                      selected = config.defaultTheme;
                    }
                  }
                  Array.prototype.slice.call(root.classList).forEach(function (name) {
                    if (name.indexOf("app-theme-") === 0) { root.classList.remove(name); }
                  });
                  if (selected !== "iris") { root.classList.add("app-theme-" + selected); }
                  root.dataset.appThemeDefault = config.defaultTheme;
                  root.dataset.appThemeCurrent = selected;
                }(document, window.APEX_THEME_FACTORY_CONFIG));
                </script>
                ```
        }
        layout {
            sequence: 1
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region script (
        name: Script
        type: staticContent
        source {
            htmlCode:
                ```html
                <script>
                const toggleRtl = ( ) => {
                    if ( $('html').hasClass('u-RTL') ) {
                        sessionStorage.removeItem('dir');
                        $('html').removeClass('u-RTL').attr('dir', 'ltr');
                    } else {
                        sessionStorage.setItem('dir', 'rtl');
                        $('html').addClass('u-RTL').attr('dir', 'rtl');
                    }
                };
                
                window.addEventListener('load', () => {
                    if ( sessionStorage.getItem('dir') ) {
                        toggleRtl();
                    }
                });
                </script>
                ```
        }
        layout {
            sequence: 20
            slot: banner
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region woops (
        name: Woops.
