{
  "schemaVersion": 1,
  "name": "citrus-pop",
  "title": "Citrus Pop",
  "version": "1.0.0",
  "tagline": "Fresh aqua canvas, deep teal structure, and buoyant tangerine energy.",
  "class": "app-theme-citrus-pop",
  "compatibility": {
    "apex": ">=26.1.0 <26.2.0",
    "themeNumber": 42,
    "baseTheme": "ut-26.1",
    "themeStyle": "Iris"
  },
  "templateOptions": {
    "navigationMenuStyle": "t-TreeNav--styleB"
  },
  "fonts": {
    "body": {
      "family": "Tajawal",
      "fallback": ["system-ui", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
      "license": "licenses/OFL.txt",
      "faces": [
        {"file": "fonts/tajawal-regular.woff2", "weight": 400, "style": "normal"},
        {"file": "fonts/tajawal-medium.woff2", "weight": 500, "style": "normal"},
        {"file": "fonts/tajawal-bold.woff2", "weight": 700, "style": "normal"},
        {"file": "fonts/tajawal-extrabold.woff2", "weight": 800, "style": "normal"}
      ]
    }
  },
  "assets": {
    "stylesheet": "theme.css",
    "runtime": "theme-factory-runtime.js",
    "cover": "preview/cover.jpg"
  }
}
