/* Shared light-family adapter rules for css/tokens.css - rendered into estate-slate, citrus-pop, cobalt-press.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
    /* Focus ring */
    --app-focus-ring: 0 0 0 2px #ffffff, 0 0 0 4px var(--__PREFIX__-amber);

    /* Type */
    --app-font-family-body:    "ThemeFactory-__NAME__-body", system-ui, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --app-font-family-heading: "ThemeFactory-__NAME__-body", system-ui, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --app-font-family-mono:    ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --app-font-weight-semibold: 600;
}

/* Universal Theme / Iris overrides on the theme-style scope */
.app-theme-__NAME__ .apex-theme-iris {
    --ut-body-background-color: var(--app-surface-page);
    --ut-body-text-color: var(--app-text-primary);
    /* Master-detail side panel and region display selector: same band as the title bar, not Iris' #f1efed. */
    --ut-body-info-background-color: var(--app-surface-page);
    /* Form error text: Iris freezes --a-form-error-text-color to its light danger literal on :root; use this theme's. */
    --a-form-error-text-color: var(--ut-palette-danger-text);
    /* Subtle info badges: Iris' #227E9E text is 4.0:1 on the pale badge (p3002, 26.2); #1d6f8f is 4.9:1. */
    --ut-palette-info-text: #1d6f8f;
    --ut-badge-subtle-info-text-color: var(--ut-palette-info-text);
    /* Code: Iris' Prism number green is 4.4:1 on the code background; #07703f is 5.9:1. */
    --prism-number: #07703f;
    --ut-component-background-color: var(--app-surface-card);
    --ut-component-text-default-color: var(--app-text-primary);
    --ut-component-text-title-color: var(--app-text-emphasized);
    --ut-component-text-subtitle-color: var(--app-text-primary);
    --ut-component-text-muted-color: var(--app-text-secondary);
    --ut-component-border-color: var(--app-border-color);
    --ut-component-inner-border-color: var(--app-border-color);
    --ut-component-highlight-background-color: var(--app-surface-hover);

    --ut-border-radius-sm: var(--app-radius-sm);
    --ut-border-radius-md: var(--app-radius-md);
    --ut-border-radius-lg: var(--app-radius-lg);

/* @segment 2 */
    --ut-palette-danger: var(--app-color-danger);
    --ut-palette-danger-contrast: var(--app-text-on-accent);
    --ut-palette-danger-shade: var(--__PREFIX__-ruby-shade);

    --ut-palette-info: var(--app-color-info);
    --ut-palette-info-contrast: var(--app-text-on-accent);
    --ut-palette-info-shade: var(--__PREFIX__-cyan-shade);

    /* Universal Theme palette (.u-color-N): Iris sets white ink on eleven of its 45 swatches, 2.9:1 to 4.5:1, and WCAG AA
       needs 4.5:1. Black ink reaches at least 4.7:1 on each of them, the ink Iris already uses on its light swatches. */
    --u-color-2-contrast: #000;
    --u-color-6-contrast: #000;
    --u-color-8-contrast: #000;
    --u-color-11-contrast: #000;
    --u-color-13-contrast: #000;
    --u-color-15-contrast: #000;
    --u-color-16-contrast: #000;
    --u-color-27-contrast: #000;
    --u-color-29-contrast: #000;
    --u-color-35-contrast: #000;
    --u-color-39-contrast: #000;
}
