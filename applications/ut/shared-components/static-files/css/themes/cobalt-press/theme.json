{
  "schemaVersion": 1,
  "name": "cobalt-press",
  "title": "Cobalt Press",
  "version": "1.0.0",
  "tagline": "Warm editorial paper, cobalt directives, and decisive vermilion marks.",
  "class": "app-theme-cobalt-press",
  "compatibility": {
    "apex": ">=26.1.0 <26.2.0",
    "themeNumber": 42,
    "baseTheme": "ut-26.1",
    "themeStyle": "Iris"
  },
  "templateOptions": {
    "navigationMenuStyle": "t-TreeNav--styleB"
  },
  "fonts": {
    "body": {
      "family": "Cairo",
      "fallback": ["system-ui", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
      "license": "licenses/OFL.txt",
      "faces": [
        {"file": "fonts/cairo-regular.woff2", "weight": 400, "style": "normal"},
        {"file": "fonts/cairo-medium.woff2", "weight": 500, "style": "normal"},
        {"file": "fonts/cairo-semibold.woff2", "weight": 600, "style": "normal"},
        {"file": "fonts/cairo-bold.woff2", "weight": 700, "style": "normal"}
      ]
    }
  },
  "assets": {
    "stylesheet": "theme.css",
    "runtime": "theme-factory-runtime.js",
    "cover": "preview/cover.jpg"
  }
}
