        buttonName: IR_REFERENCE
        label: Full IR reference
        layout {
            sequence: 40
            region: @theme-lab-overlays
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1402
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
