{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "theme",
    "gitCommit",
    "packageSha256",
    "capturedAt",
    "consumer",
    "viewportWidth",
    "url",
    "appId",
    "appAlias",
    "pageId",
    "apexVersion",
    "bodyClasses",
    "htmlClasses",
    "cssUrls",
    "javascriptUrls",
    "loadedUrls",
    "windowApp",
    "windowAlpine",
    "activeTheme",
    "registry",
    "switcherAvailable",
    "consoleErrors",
    "failedRequests",
    "fonts",
    "fontApexFamilyBefore",
    "fontApexFamilyAfter",
    "fontsVerified",
    "accessibilityVerified",
    "persistenceVerified"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "browser-runtime" },
    "theme": { "type": "string", "minLength": 1 },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capturedAt": { "type": "string" },
    "consumer": { "enum": ["minimal", "business"] },
    "viewportWidth": { "enum": [1440, 1024, 768, 375] },
    "url": { "type": "string" },
    "appId": { "type": "string" },
    "appAlias": { "type": "string" },
    "pageId": { "type": "string" },
    "apexVersion": { "type": "string" },
    "bodyClasses": { "type": "array", "items": { "type": "string" } },
    "htmlClasses": { "type": "array", "items": { "type": "string" } },
    "cssUrls": { "type": "array", "items": { "type": "string" } },
    "javascriptUrls": { "type": "array", "items": { "type": "string" } },
    "loadedUrls": { "type": "array", "items": { "type": "string" } },
    "windowApp": { "type": ["object", "null"] },
    "windowAlpine": { "type": ["string", "null"] },
    "activeTheme": { "type": "string" },
    "registry": { "type": "object" },
    "switcherAvailable": { "type": "boolean" },
    "consoleErrors": { "type": "array", "items": { "type": "string" } },
    "failedRequests": { "type": "array", "items": { "type": "string" } },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "family", "weight", "style", "check", "requestUrl", "mimeType"],
        "properties": {
          "role": { "enum": ["body", "heading", "mono"] },
          "family": { "type": "string" },
          "weight": { "type": "integer" },
          "style": { "enum": ["normal", "italic"] },
          "check": { "type": "boolean" },
          "requestUrl": { "type": "string" },
          "mimeType": { "const": "font/woff2" }
        }
      }
    },
    "fontApexFamilyBefore": { "type": "string" },
    "fontApexFamilyAfter": { "type": "string" },
    "fontsVerified": { "const": true },
    "accessibilityVerified": { "const": true },
    "persistenceVerified": { "const": true }
  }
}
