/* Shared light-family adapter rules for css/apex/shell.css - rendered into estate-slate, citrus-pop, cobalt-press.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
.app-theme-__NAME__ .apex-theme-iris .t-Header-logo-link {
    font-weight: var(--app-font-weight-semibold);
    color: var(--app-text-chrome);
    letter-spacing: -0.02em;
}

.app-theme-__NAME__ .apex-theme-iris .t-Header-logo-link:hover {
    color: var(--app-color-primary);
}

.app-theme-__NAME__ .apex-theme-iris .t-Header .t-Button--header {
    --a-button-text-color: var(--app-text-chrome);
    --a-button-hover-text-color: var(--app-text-chrome);
    --a-button-border-radius: var(--app-radius-sm);
}

/* ---- Side navigation: sleek command rail ------------------------------------------------ */
.app-theme-__NAME__ .apex-theme-iris .t-Body-nav {
    --ut-body-nav-background-color: var(--app-surface-chrome);
    --ut-body-nav-text-color: var(--app-text-chrome-muted);
    --ut-body-nav-border-color: var(--app-border-chrome);
    --ut-body-nav-scrollbar-thumb-background-color: var(--app-border-chrome);
    --ut-body-nav-scrollbar-track-background-color: var(--app-surface-chrome);
}

.app-theme-__NAME__ .apex-theme-iris .t-Body-nav .t-TreeNav {
    --a-treeview-node-selected-background-color: var(--app-accent-shade);
    --a-treeview-node-selected-text-color: var(--app-color-primary);
    --a-treeview-node-focused-background-color: var(--app-accent-shade);
    --a-treeview-node-focused-text-color: var(--app-color-primary);
    --a-treeview-node-focused-shadow: inset 0 0 0 1px var(--app-color-primary);
    --a-treeview-node-font-weight: var(--app-font-weight-medium);
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-current--top,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel ul,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel.is-collapsible > .a-TreeView-row {
    background-color: transparent;
    color: inherit;
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-current,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-current--top.is-selected,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-selected {
    background-color: var(--app-accent-shade);
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-hover {
    background-color: var(--app-surface-chrome-hover) !important; /* Iris: .is-hover{...!important} */
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-hover + .a-TreeView-content,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-hover + .a-TreeView-toggle,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav .a-TreeView-node--topLevel .a-TreeView-row.is-hover + .a-TreeView-toggle + .a-TreeView-content {
    color: var(--app-text-chrome);
}

/* Style B Navigation Menu */
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-row {
    border-radius: var(--app-radius-sm);
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-row.is-current--top,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-row.is-current--top.is-selected {
    background-color: var(--app-accent-shade);
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-content.is-current--top,
.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-row.is-current--top.is-selected + .a-TreeView-toggle {
    color: var(--app-color-primary);
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-content.is-current--top.is-hover {
    color: var(--app-color-primary) !important; /* Iris: color:#fff!important */
}

.app-theme-__NAME__ .apex-theme-iris .t-TreeNav--styleB .a-TreeView-node--topLevel .a-TreeView-row.is-current--top.is-hover {
    background-color: var(--app-accent-shade) !important; /* Iris: #006c91!important */
}

/* ---- Title bar: canvas-coloured, hairline border ----------------------------------------- */
.app-theme-__NAME__ .apex-theme-iris .t-Body-title {
    --ut-body-title-background-color: var(--app-surface-page);
    --ut-body-title-box-shadow: none;
    --ut-body-title-border-width: 1px;
    --ut-body-title-border-color: var(--app-border-color);
}

.app-theme-__NAME__ .apex-theme-iris .t-HeroRegion-title {
    font-size: var(--app-text-2xl);
    font-weight: var(--app-font-weight-semibold);
    line-height: 2rem;
    letter-spacing: -0.02em;
}

.app-theme-__NAME__ .apex-theme-iris .t-HeroRegion-icon {
    border-radius: var(--app-radius-md);
    width: 3rem;
    height: 3rem;
    line-height: 3rem;
    font-size: 1.5rem;
}
