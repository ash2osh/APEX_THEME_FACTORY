page 0 (
    name: Page Zero

    region theme (
        name: Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <script>
                /* APEX Theme Factory: pick the active theme package before the page paints.
                   All packages are loaded by #APP_FILES#css/app.css; each is scoped to html.app-theme-<name>.
                   Switch with the URL hash — #theme=<name> stores the choice in localStorage (reaches dialog
                   pages too), #theme=default clears it — or App.theme.use('<name>') from js/app.js.
                   Query parameters are not usable here (session-state protection rejects unknown ones).
                   The navigation-bar "Theme" menu and page 405 call App.theme.use(); DEFAULT is maintained by
                   scripts/apply-theme.sh, THEMES (installed packages) by scripts/sync-static.sh. A stored name
                   that is not installed (a typo, a removed package) is dropped; 'none' means bare Iris. */
                (function () {
                    var DEFAULT = 'linen';
                    var THEMES = ' carbon-volt citrus-pop cobalt-press estate-slate-dark estate-slate linen solarized-dark velvet-signal ';
                    var ok = /^[a-z0-9-]{1,40}$/, t = null, m = null;
                    try { m = /(?:^#|&)theme=([a-z0-9-]{1,40})(?:&|$)/.exec(location.hash); } catch (e) {}
                    try {
                        if (m && m[1] === 'default') { localStorage.removeItem('app.theme'); }
                        else if (m) { localStorage.setItem('app.theme', m[1]); }
                        t = localStorage.getItem('app.theme');
                        if (t && t !== 'none' && THEMES.indexOf(' ' + t + ' ') === -1) {
                            localStorage.removeItem('app.theme');
                            t = null;
                        }
                    } catch (e) {}
                    if (!t || !ok.test(t)) { t = DEFAULT; }
                    document.documentElement.classList.add('app-theme-' + t);
                    document.documentElement.setAttribute('data-app-theme-default', DEFAULT); /* read by App.theme */
                })();
                </script>
                ```
        }
        layout {
            sequence: 15
            slot: banner
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region theme_dialog (
        name: Theme (dialog, drawer, wizard pages)
        type: staticContent
        source {
            htmlCode:
                ```html
                <!-- Page 0 may only use Standard-template slots; APEX maps them by position number, and
                     breadcrumbBar = #REGION_POSITION_01# = the first position of the Modal Dialog, Drawer and
                     Wizard Modal Dialog templates (those have no banner slot). Idempotent with region "theme". -->
                <script>
                /* APEX Theme Factory: pick the active theme package before the page paints.
                   All packages are loaded by #APP_FILES#css/app.css; each is scoped to html.app-theme-<name>.
                   Switch with the URL hash — #theme=<name> stores the choice in localStorage (reaches dialog
                   pages too), #theme=default clears it — or App.theme.use('<name>') from js/app.js.
                   Query parameters are not usable here (session-state protection rejects unknown ones).
                   The navigation-bar "Theme" menu and page 405 call App.theme.use(); DEFAULT is maintained by
                   scripts/apply-theme.sh, THEMES (installed packages) by scripts/sync-static.sh. A stored name
                   that is not installed (a typo, a removed package) is dropped; 'none' means bare Iris. */
                (function () {
                    var DEFAULT = 'linen';
                    var THEMES = ' carbon-volt citrus-pop cobalt-press estate-slate-dark estate-slate linen solarized-dark velvet-signal ';
                    var ok = /^[a-z0-9-]{1,40}$/, t = null, m = null;
                    try { m = /(?:^#|&)theme=([a-z0-9-]{1,40})(?:&|$)/.exec(location.hash); } catch (e) {}
                    try {
                        if (m && m[1] === 'default') { localStorage.removeItem('app.theme'); }
                        else if (m) { localStorage.setItem('app.theme', m[1]); }
                        t = localStorage.getItem('app.theme');
                        if (t && t !== 'none' && THEMES.indexOf(' ' + t + ' ') === -1) {
                            localStorage.removeItem('app.theme');
                            t = null;
                        }
                    } catch (e) {}
                    if (!t || !ok.test(t)) { t = DEFAULT; }
                    document.documentElement.classList.add('app-theme-' + t);
                    document.documentElement.setAttribute('data-app-theme-default', DEFAULT); /* read by App.theme */
                })();
                </script>
                ```
        }
        layout {
            sequence: 1
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region script (
        name: Script
        type: staticContent
        source {
            htmlCode:
                ```html
                <script>
                const toggleRtl = ( ) => {
                    if ( $('html').hasClass('u-RTL') ) {
                        sessionStorage.removeItem('dir');
                        $('html').removeClass('u-RTL').attr('dir', 'ltr');
                    } else {
                        sessionStorage.setItem('dir', 'rtl');
                        $('html').addClass('u-RTL').attr('dir', 'rtl');
                    }
                };
                
                window.addEventListener('load', () => {
                    if ( sessionStorage.getItem('dir') ) {
                        toggleRtl();
                    }
                });
                </script>
                ```
        }
        layout {
            sequence: 20
            slot: banner
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region woops (
