page 409 (
    name: Theme Factory Lifecycle
    alias: THEME-FACTORY-LIFECYCLE
    title: Theme Factory Lifecycle - &APP_TITLE.
    pageGroup: @design
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @universal-theme-breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region theme-factory-disclosure-region (
        name: Theme Factory Disclosure Region
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                begin
                  -- RETURN the markup; never sys.htp.p here. A dynamicContent region refreshes through
                  -- apex.server.plugin, whose success handler assigns regions[0].result. htp.p output is
                  -- written to the response stream ahead of the JSON envelope, so the parse fails, result is
                  -- null and apexafterrefresh never fires — the region can then never be refreshed.
                  -- Verified live twice on 2026-09-16 (.agents/findings/pending/2026-09-16-dynamic-content-htp-p-cannot-refresh.md).
                  return '<div x-data="themeFactoryDisclosure(''P409_DISCLOSURE_OPEN'')">'
                      || '  <button type="button" x-on:click="toggle" x-bind:aria-expanded="open.toString()" aria-controls="theme_factory_disclosure_panel">Toggle details</button>'
                      || '  <div id="theme_factory_disclosure_panel" x-show="open" x-cloak>Refresh-safe Alpine content</div>'
                      || '</div>';
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: theme_factory_disclosure_region
        }
    )

    pageItem P409_DISCLOSURE_OPEN (
        type: hidden
        layout {
            sequence: 10
            region: @theme-factory-disclosure-region
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    button refresh-fixture (
        buttonName: REFRESH_FIXTURE
        label: Refresh Fixture
        layout {
            sequence: 10
            region: @theme-factory-disclosure-region
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refresh-fixture (
        name: Refresh Fixture
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh-fixture
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.region('theme_factory_disclosure_region').refresh();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
