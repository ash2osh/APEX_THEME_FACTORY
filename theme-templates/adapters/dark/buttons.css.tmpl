/* Shared dark-family adapter rules for css/apex/buttons.css - rendered into solarized-dark, carbon-volt, velvet-signal.
   Placeholders: __NAME__ = theme name, __PREFIX__ = private palette prefix. After editing, run
   scripts/theme.sh adapters (the offline gate fails while any theme is out of date). */

/* @segment 1 */
.app-theme-__NAME__ .apex-theme-iris {
    /* geometry: 36px control, 13px/500, 4px radius */
    --a-button-font-size: var(--app-text-sm);
    --a-button-line-height: 1.125rem;
    --a-button-padding-y: .5625rem;
    --a-button-padding-x: .875rem;
    --a-button-font-weight: var(--app-font-weight-medium);
    --a-button-border-radius: var(--app-radius-sm);
    --a-button-icon-size: 1rem;

    /* default button: card surface; the border identifies it on a same-coloured region (WCAG 1.4.11) */
    --a-button-background-color: var(--app-surface-card);
    --a-button-text-color: var(--app-text-primary);
    --a-button-border-color: var(--app-border-strong);
    --a-button-hover-background-color: var(--app-surface-hover);
    --a-button-hover-border-color: var(--app-border-strong);
    --a-button-hover-text-color: var(--app-text-emphasized);
    --a-button-active-background-color: var(--app-surface-selected);
    --a-button-focus-background-color: var(--app-surface-hover);
    --a-button-focus-border-color: var(--__PREFIX__-cyan);
    --a-button-shadow: none;
    --a-button-hover-shadow: none;
    --a-button-active-shadow: none;
}

/* Hot = the cyan action (card actions and checked button-group segments share it; Iris lists them together) */
.app-theme-__NAME__ .apex-theme-iris .t-Button--hot:not(.t-Button--simple):not(.t-Button--noUI):not(.t-Button--link):not(.t-Button--danger):not(.t-Button--success):not(.t-Button--warning):not(.t-Button--primary),
.app-theme-__NAME__ .apex-theme-iris .a-CardView-button--hot,
.app-theme-__NAME__ .apex-theme-iris .apex-button-group input:checked + label,
.app-theme-__NAME__ .apex-theme-iris .t-Form-fieldContainer--radioButtonGroup .apex-item-group--rc input:checked + label {
    --a-button-background-color: var(--__PREFIX__-cyan);
    --a-button-text-color: var(--app-text-on-accent);
    --a-button-border-color: transparent;
    --a-button-hover-background-color: var(--__PREFIX__-cyan-bright);
    --a-button-hover-border-color: transparent;
    --a-button-hover-text-color: var(--app-text-on-accent);
    --a-button-active-background-color: var(--__PREFIX__-cyan);
    --a-button-active-text-color: var(--app-text-on-accent);
    --a-button-focus-background-color: var(--__PREFIX__-cyan-bright);
    --a-button-focus-text-color: var(--app-text-on-accent);
    --a-button-font-weight: var(--app-font-weight-semibold);
}

/* Primary palette button: white text on the raw accent fails AA, so use the text-safe tint with dark text */
.app-theme-__NAME__ .apex-theme-iris .t-Button--primary {
    --a-button-background-color: var(--app-color-primary);
    --a-button-text-color: var(--app-text-on-accent);
    --a-button-border-color: transparent;
    --a-button-hover-background-color: var(--__PREFIX__-blue-bright);
    --a-button-hover-border-color: transparent;
    --a-button-hover-text-color: var(--app-text-on-accent);
}

/* Visible keyboard focus on every button, consistent with fields */
.app-theme-__NAME__ .apex-theme-iris .t-Button:focus-visible {
    box-shadow: var(--app-focus-ring);
    outline: none;
}
